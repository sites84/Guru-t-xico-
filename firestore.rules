rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'totalPoints', 'completedTasksCount', 'currentRank', 'achievements', 'completedTaskIds', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'totalPoints', 'completedTasksCount', 'currentRank', 'achievements', 'completedTaskIds', 'createdAt', 'updatedAt']) &&
             data.id == userId &&
             data.id == request.auth.uid &&
             data.email is string && data.email.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             data.totalPoints is number && data.totalPoints >= 0 &&
             data.completedTasksCount is number && data.completedTasksCount >= 0 &&
             data.currentRank is string && data.currentRank.size() <= 80 &&
             data.achievements is list && data.achievements.size() <= 50 &&
             data.completedTaskIds is list && data.completedTaskIds.size() <= 100 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get, list: if true;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['totalPoints', 'completedTasksCount', 'currentRank', 'achievements', 'completedTaskIds', 'updatedAt', 'displayName', 'photoURL']);

      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
